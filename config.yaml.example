recording:
  sample_rate: 16000
  channels: 1
  format: wav
  max_duration_minutes: 360
  recordings_dir: recordings
  # After this many seconds of continuous silence, pause writing until sound
  # returns (keeps a meeting left running over a break from bloating). 0 = off.
  auto_pause_silence_seconds: 90
  auto_pause_level: 0.01

transcription:
  # Active engine: whisper | indicwhisper | parakeet
  engine: whisper
  language: en

  # Speaker diarization (requires pyannote.audio and HF_TOKEN in .env)
  diarization:
    enabled: false

  engines:
    whisper:
      model: mlx-community/whisper-large-v3-turbo
      description: "General-purpose, 99 languages, good Indian English"

    indicwhisper:
      model: ai4bharat/indicwhisper-large-v2
      description: "Fine-tuned for Indian languages + Indian English, best for Hindi-English code-switching"

    parakeet:
      model: senstella/parakeet-mlx
      description: "10x faster than Whisper, better noise robustness, English-only"

processing:
  # LLM provider: gemini | openai | anthropic | ollama
  provider: gemini
  # Model name for the chosen provider. Examples:
  #   gemini:    gemini-2.5-flash, gemini-2.0-flash
  #   openai:    gpt-4o, gpt-4o-mini
  #   anthropic: claude-opus-4-6, claude-sonnet-4-6
  #   ollama:    llama3, mistral
  model: gemini-2.5-flash
  temperature: 0.3
  # Default meeting type (run: python -m src.cli types)
  default_type: default

# Who "you" are — used to file to-dos as "Mine" in the dashboard. Set this in
# Settings → Identity (no need to edit this file). Aliases is a comma-separated
# list of other names/nicknames the AI might use for you.
user:
  name: ""
  aliases: ""

output:
  notes_dir: notes
  template: default

menubar:
  hotkey: command+shift+r
  show_timer: true
  sound_on_start: true
  sound_on_stop: true
